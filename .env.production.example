# ==============================================================================
# Production Environment Variables (.env.production.example)
# ==============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Kafka Configuration (Internal Broker Address in Docker Network or Managed Cluster)
KAFKA_BROKER=kafka:29092
KAFKA_CLIENT_ID=event-driven-api-prod
KAFKA_GROUP_ID=event-driven-group-prod

# Database Configuration (Provide credentials for production PostgreSQL)
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/event_driven_production
POSTGRES_DB=event_driven_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Resource & Memory Limits
# POSTGRES_SHARED_BUFFERS=256MB
# APP_NODE_OPTIONS=--max-old-space-size=512
# KAFKA_HEAP_OPTS=-Xmx1024m -Xms512m
# ZK_HEAP_OPTS=-Xmx512m -Xms256m
