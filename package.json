{
  "name": "event-driven-kafka-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "pnpm workspace: event-driven Kafka backend, shared contracts, and the design-system dashboard.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @kafka-demo/backend dev",
    "test": "pnpm --filter @kafka-demo/backend test",
    "test:all": "pnpm -r test",
    "db:migrate": "pnpm --filter @kafka-demo/backend db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "kafka",
    "event-driven",
    "microservices",
    "nodejs",
    "typescript",
    "postgresql",
    "design-system",
    "storybook"
  ],
  "author": "Giovani Rodrigues (https://github.com/GiovaniRodrigo)",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
