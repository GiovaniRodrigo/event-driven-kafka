{
  "name": "event-driven-kafka-architecture",
  "version": "1.0.0",
  "description": "Production-grade reference laboratory for Event-Driven Architecture with Apache Kafka, Node.js, TypeScript, PostgreSQL, Transactional Outbox, Saga Orchestrator, CQRS, and Chaos Engineering.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:http": "jest tests/http --runInBand",
    "test:realtime": "jest tests/realtime --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:watch": "jest --watch",
    "load-test": "ts-node tests/load/load-generator.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f scripts/init-db.sql",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "kafka",
    "event-driven",
    "microservices",
    "nodejs",
    "typescript",
    "postgresql",
    "saga-pattern",
    "transactional-outbox",
    "cqrs",
    "idempotent-consumer",
    "chaos-engineering"
  ],
  "author": "Giovani Rodrigo <giovanif245@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.2",
    "jest": "^29.5.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
