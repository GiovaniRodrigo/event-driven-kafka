# ==============================================================================
# Development Environment Variables (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=event-driven-api
KAFKA_GROUP_ID=event-driven-group

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_driven_test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_driven_test
DB_USER=postgres
DB_PASSWORD=postgres

# Resource Ceilings (Injected automatically when using scripts/start.sh)
# ZK_MEM_LIMIT=512m
# KAFKA_MEM_LIMIT=1250m
# POSTGRES_MEM_LIMIT=512m
# APP_MEM_LIMIT=512m
