NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Kafka
KAFKA_BROKER=localhost:9092

# Database
# Either provide a single DATABASE_URL (takes precedence)...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_driven_test
# ...or the discrete DB_* variables below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_driven_test
DB_USER=postgres
DB_PASSWORD=postgres
