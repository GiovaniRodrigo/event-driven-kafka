{
  "name": "@kafka-demo/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade event-driven microservices architecture using Kafka, Node.js, and PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "psql \"$DATABASE_URL\" -f ../../scripts/init-db.sql"
  },
  "dependencies": {
    "@kafka-demo/contracts": "workspace:*",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.2",
    "jest": "^29.5.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
